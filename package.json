{
	"name": "Likes to Go",
	"version": "2.6.0",
	"private": true,
	"type": "module",
	"description": "Your music taste in a file. A Chrome extension that saves your SoundCloud likes as a file. Your data, to go.",
	"author": "RZUGA <z.zuga.a@gmail.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/ZUGAZ/likes-to-go.git"
	},
	"packageManager": "pnpm@10.28.2",
	"scripts": {
		"dev": "wxt --host 0.0.0.0",
		"build": "wxt build",
		"build:dev": "wxt build -m development",
		"package": "wxt zip",
		"verify:package-war": "node --experimental-strip-types scripts/verify-package-war.ts",
		"report:package-size": "node --experimental-strip-types scripts/verify-package-size.ts --report",
		"verify:package-size": "node --experimental-strip-types scripts/verify-package-size.ts --check",
		"record:package-size-budgets": "node --experimental-strip-types scripts/verify-package-size.ts --record",
		"ci:release-equivalent": "pnpm package && pnpm verify:package-war && pnpm verify:package-size",
		"optimize:mascot": "bash scripts/optimize-mascot-webp.sh",
		"optimize:mascot:check": "bash scripts/optimize-mascot-webp.sh --check",
		"test": "vitest",
		"test:run": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:ci": "playwright test --config=playwright.ci.config.ts",
		"test:e2e:storybook": "PLAYWRIGHT_STORYBOOK_URL=http://127.0.0.1:6006 playwright test -c playwright.storybook.config.ts",
		"test:types": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"ci:quality": "bash scripts/ci-quality.sh",
		"knip": "knip",
		"lint-staged": "lint-staged",
		"storybook": "storybook dev -p 6006 --host 0.0.0.0",
		"build-storybook": "storybook build",
		"prepare": "bash scripts/prepare-effect.sh && husky",
		"commit": "bash scripts/commit.sh",
		"postinstall": "wxt prepare"
	},
	"dependencies": {
		"effect": "^3.21.2",
		"solid-js": "^1.9.11",
		"solid-transition-group": "^0.3.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,json,css,md,html}": "prettier --write"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.4.2",
		"@commitlint/config-conventional": "^20.4.2",
		"@effect/language-service": "^0.80.0",
		"@effect/vitest": "0.29.0",
		"@eslint/js": "^9.39.2",
		"@playwright/test": "^1.61.1",
		"@solidjs/testing-library": "^0.8.10",
		"@storybook/addon-docs": "^10.5.2",
		"@tailwindcss/vite": "^4.2.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@types/chrome": "^0.1.37",
		"@wxt-dev/auto-icons": "^1.1.0",
		"@wxt-dev/module-solid": "^1.1.4",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-solid": "^0.14.5",
		"fast-check": "^4.5.3",
		"happy-dom": "^20.6.3",
		"husky": "^9.1.7",
		"knip": "^6.33.0",
		"lint-staged": "^16.3.3",
		"prettier": "^3.8.1",
		"storybook": "^10.5.2",
		"storybook-solidjs-vite": "^10.6.0",
		"tailwindcss": "^4.2.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.0",
		"vite": "^7.3.1",
		"vite-plugin-solid": "^2.11.11",
		"vitest": "^4.0.18",
		"wxt": "^0.20.17"
	}
}
